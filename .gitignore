# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this is usually fine to prevent tracking.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of collaboration, if you choose to not let it be tracked, uncomment the following line:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in git.
#   poetry.lock
#   Pedantic: uncomment the next line if you also want to ignore poetry.lock
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in git.
#pdm.lock
#   pdm build stage
.pdm-build/

# Pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of collaboration, if you choose to not let it be tracked, uncomment the following line:
#Pipfile.lock

# PEP 582; used by e.g. github.com/davidhalter/jedi to store dependencies, not normally shareable
__pypackages__/

